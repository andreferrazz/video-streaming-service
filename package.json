{
	"name": "video-streaming-service",
	"private": true,
	"packageManager": "pnpm@10.33.2",
	"engines": {
		"node": "26.13.1"
	},
	"scripts": {
		"dev": "pnpm --filter webapp dev",
		"build": "pnpm --filter webapp build",
		"check": "pnpm --filter webapp check",
		"stack:up": "docker compose -f compose.yaml -f compose.dev.yaml up -d --wait",
		"stack:down": "docker compose -f compose.yaml -f compose.dev.yaml down"
	}
}

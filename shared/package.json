{
	"name": "shared",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"exports": {
		"./db": "./src/db/index.ts",
		"./storage": "./src/storage.ts"
	},
	"scripts": {
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"check": "tsc --noEmit",
		"storage:check": "node --env-file-if-exists=../.env src/storage-check.ts"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "3.1171.0",
		"@aws-sdk/lib-storage": "3.1171.0",
		"@aws-sdk/s3-request-presigner": "3.1171.0",
		"drizzle-orm": "0.45.4",
		"postgres": "4.1.1"
	},
	"devDependencies": {
		"@types/node": "26.6.6",
		"drizzle-kit": "0.31.11",
		"typescript": "6.0.3"
	}
}

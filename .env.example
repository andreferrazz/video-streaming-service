# Stack secrets (compose.yaml)
POSTGRES_PASSWORD=
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=

# App settings (webapp and worker)
DATABASE_URL=postgres://videos:<POSTGRES_PASSWORD>@localhost:5432/videos
S3_ENDPOINT=http://localhost:3900
S3_REGION=garage
S3_BUCKET=videos
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
ADMIN_PASSWORD=
SESSION_SECRET=

# Public address of the site. Only the deployed web app uses it, but Compose
# needs a value to read compose.yaml; locally use http://localhost:5173.
ORIGIN=

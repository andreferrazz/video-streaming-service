# Stack secrets (compose.yaml)
POSTGRES_PASSWORD=
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=

# App settings (webapp and worker)
DATABASE_URL=postgres://videos:<POSTGRES_PASSWORD>@localhost:5432/videos
S3_ENDPOINT=http://localhost:3900
S3_REGION=garage
S3_BUCKET=videos
# How the bucket is addressed: true for host/bucket (Garage), false for bucket.host.
S3_FORCE_PATH_STYLE=true
# The address browsers use to reach storage, if different from S3_ENDPOINT. Optional.
# S3_PUBLIC_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
ADMIN_PASSWORD=
SESSION_SECRET=
# The most all videos together may hold, in gigabytes. Optional; defaults to 10.
# STORAGE_LIMIT_GB=10
# The largest single file accepted, in gigabytes. Optional; defaults to 20.
# UPLOAD_MAX_GB=20
# Hours without activity before an unfinished upload is discarded. Optional; defaults to 24.
# UPLOAD_EXPIRY_HOURS=24

# Public address of the site. Only the deployed web app uses it, but Compose
# needs a value to read compose.yaml; locally use http://localhost:5173.
ORIGIN=

# Deployed stack only: use storage other than the bundled Garage. Leave these
# unset to use Garage. See docs/storage.md.
# EXTERNAL_S3_ENDPOINT=
# EXTERNAL_S3_REGION=
# EXTERNAL_S3_BUCKET=
# EXTERNAL_S3_FORCE_PATH_STYLE=
# GARAGE_REPLICAS=0
